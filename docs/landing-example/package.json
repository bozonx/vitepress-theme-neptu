{
  "name": "vitepress-theme-neptu-landing-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example site using vitepress-theme-neptu-landing",
  "type": "module",
  "author": "(Ivan Kozyrin <ipkozyrin@gmail.com>)",
  "license": "MIT",
  "scripts": {
    "dev": "vitepress dev src",
    "build": "VITEPRESS_BASE=/vitepress-theme-neptu-blog/landing/ vitepress build src --base /vitepress-theme-neptu-blog/landing/ && pnpm pagefind",
    "pagefind": "pagefind --verbose --site ./src/.vitepress/dist --glob '**/*.html'",
    "preview": "vitepress preview src --base /vitepress-theme-neptu-blog/landing/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "vitepress": "catalog:",
    "vitepress-theme-neptu-blog": "workspace:*",
    "vitepress-theme-neptu-landing": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "pagefind": "catalog:",
    "tailwindcss": "catalog:",
    "typescript-eslint": "catalog:",
    "vue-eslint-parser": "catalog:"
  }
}
