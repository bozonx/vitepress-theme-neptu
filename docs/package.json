{
  "name": "vitepress-theme-neptu-docs",
  "version": "0.1.0",
  "description": "Documentation and demo site using vitepress-theme-neptu",
  "type": "module",
  "author": "(Ivan Kozyrin <ipkozyrin@gmail.com>)",
  "license": "MIT",
  "scripts": {
    "dev": "vitepress dev src",
    "pagefind": "pagefind --verbose --site ./src/.vitepress/dist --glob '**/*.html'",
    "build": "VITEPRESS_BASE=/vitepress-theme-neptu/ vitepress build src --base /vitepress-theme-neptu/ && npm run pagefind",
    "preview": "vitepress preview src --base /vitepress-theme-neptu/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "vitepress": "2.0.0-alpha.18",
    "vitepress-theme-neptu": "*",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
