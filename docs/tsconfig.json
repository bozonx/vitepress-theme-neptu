{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "vitepress-theme-neptu-blog": ["../packages/blog/src/index.ts"],
      "vitepress-theme-neptu-blog/*": ["../packages/blog/src/*"]
    }
  },
  "include": [
    "src/.vitepress/**/*.ts",
    "src/.vitepress/**/*.vue",
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ]
}
