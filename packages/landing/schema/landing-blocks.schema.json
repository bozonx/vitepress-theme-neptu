                    "centered",
                    "cover",
                    "plain"
                  ]
                },
                "actions": {
                  "$ref": "#/definitions/actions"
                },
                "image": {
                  "$ref": "#/definitions/media"
                },
                "note": {
                  "type": "string"
                },
                "glow": {
                  "type": "boolean"
                },
                "overlay": {
                  "type": "boolean"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "features"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/feature"
                  }
                },
                "cols": {
                  "enum": [
                    1,
                    2,
                    3,
                    4
                  ]
                },
                "variant": {
                  "enum": [
                    "card",
                    "plain",
                    "bordered"
                  ]
                },
                "iconPosition": {
