{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bozonx/vitepress-theme-neptu/packages/landing/schema/landing-blocks.schema.json",
  "title": "Neptu Landing — page frontmatter",
  "description": "Frontmatter of a landing page rendered by <LandingRenderer />.",
  "type": "object",
  "properties": {
    "layout": {
      "enum": [
        "landing",
        "home"
      ],
      "description": "`landing` renders the `blocks:` array on its own; `home` is the component-authored mode with an explicit <LandingRenderer /> or <LnPage>."
    },
    "markdownStyles": {
      "const": false
    },
    "blocks": {
      "type": "array",
      "description": "Ordered list of sections. Rendered top to bottom.",
      "items": {
        "$ref": "#/definitions/block"
      }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Anchor id."
        },
        "bg": {
          "enum": [
            "base",
            "soft",
            "mute",
            "inverse",
            "brand",
            "transparent"
          ],
          "default": "base"
        },
        "width": {
          "enum": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "default"
        },
        "padding": {
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        "align": {
          "enum": [
            "start",
            "center"
          ]
        },
        "divider": {
          "type": "boolean"
        },
        "reveal": {
          "type": "boolean",
          "description": "Enable the scroll-reveal animation (default `true`)."
        },
        "noReveal": {
          "type": "boolean",
          "description": "Deprecated alias for `reveal: false`."
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "Inline HTML allowed."
        },
        "text": {
          "type": "string",
          "description": "Inline HTML allowed."
        }
      }
    },
    "icon": {
      "description": "Iconify name (`fa6-solid:rocket`), emoji, or image path.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "media": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "video": {
              "type": "string"
            },
            "poster": {
              "type": "string"
            },
            "width": {
              "type": [
                "number",
                "string"
              ]
            },
            "height": {
              "type": [
                "number",
                "string"
              ]
            },
            "ratio": {
              "type": "string",
              "examples": [
                "16/9",
                "4/3"
              ]
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            },
            "decorative": {
              "type": "boolean"
            },
            "autoplay": {
              "type": "boolean"
            },
            "controls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "text",
        "link"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "brand",
            "alt",
            "ghost",
            "outline",
            "link"
          ]
        },
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        "icon": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/action"
      }
    },
    "feature": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/definitions/icon"
        },
        "image": {
          "$ref": "#/definitions/media"
        },
        "link": {
          "type": "string"
        },
        "linkText": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meta": {
          "type": "array",
          "items": { "type": "string" }
        },
        "date": { "type": "string" },
        "target": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "span": {
          "enum": [
            1,
            2
          ],
          "description": "Bento only."
        },
        "rowSpan": {
          "enum": [
            1,
            2
          ],
          "description": "Bento only."
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "feature-split only."
        },
        "actions": {
          "$ref": "#/definitions/actions"
        }
      },
      "additionalProperties": false
    },
    "carouselSlide": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/definitions/icon"
        },
        "image": {
          "$ref": "#/definitions/media"
        },
        "link": {
          "type": "string"
        },
        "linkText": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meta": {
          "type": "array",
          "items": { "type": "string" }
        },
        "date": { "type": "string" },
        "actions": {
          "$ref": "#/definitions/actions"
        },
        "target": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
