{
  "name": "vitepress-theme-neptu-landing",
  "version": "0.20.0",
  "description": "VitePress theme for project sites: a block-based landing page, optional docs, switchable color and style themes",
  "types": "./src/types.d.ts",
  "type": "module",
  "author": "Ivan Kozyrin <ipkozyrin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "schema",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts"
    },
    "./configs": {
      "types": "./src/configs/index.ts",
      "import": "./src/configs/index.ts"
    },
    "./blocks": {
      "types": "./src/blocks/index.ts",
      "import": "./src/blocks/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./composables": {
      "types": "./src/composables/index.ts",
      "import": "./src/composables/index.ts"
    },
    "./landing.css": "./src/styles/landing.css",
    "./landing-vars.css": "./src/styles/landing-vars.css",
    "./style-presets.css": "./src/styles/style-presets.css",
    "./vitepress-bridge.css": "./src/styles/vitepress-bridge.css",
    "./site-theme-fix.css": "./src/styles/site-theme-fix.css",
    "./src/*": "./src/*",
    "./landing-blocks.schema.json": "./schema/landing-blocks.schema.json"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vitepress": "^2.0.0-alpha.18",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "catalog:",
    "vitepress-theme-neptu-blog": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "typescript-eslint": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm exec playwright test --config tests/e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report tests/e2e/playwright-report"
  }
}
