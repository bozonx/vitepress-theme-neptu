{
  "name": "vitepress-theme-neptu",
  "version": "0.20.0",
  "private": true,
  "description": "Monorepo for the Neptu VitePress themes — blog theme, landing theme, docs, and templates.",
  "type": "module",
  "author": "Ivan Kozyrin <ipkozyrin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "scripts": {
    "generate:icons": "npm run generate:icons --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "validate:blocks": "npm run validate:blocks -w vitepress-theme-neptu-landing",
    "check": "npm run generate:icons && npm run validate:blocks && npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "blog:dev": "npm run dev -w vitepress-theme-neptu-docs",
    "blog:build": "npm run build -w vitepress-theme-neptu-docs",
    "blog:preview": "npm run preview -w vitepress-theme-neptu-docs",
    "landing:dev": "npm run dev -w vitepress-theme-neptu-landing-example",
    "landing:build": "npm run build -w vitepress-theme-neptu-landing-example",
    "landing:preview": "npm run preview -w vitepress-theme-neptu-landing-example",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
