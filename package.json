{
  "name": "vitepress-theme-neptu",
  "version": "0.20.0",
  "private": true,
  "description": "Monorepo for the Neptu VitePress themes — blog theme, landing theme, docs, and templates.",
  "type": "module",
  "author": "Ivan Kozyrin <ipkozyrin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "scripts": {
    "generate:icons": "pnpm --filter vitepress-theme-neptu-blog generate:icons",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter vitepress-theme-neptu-blog test:watch",
    "test:coverage": "pnpm --filter vitepress-theme-neptu-blog test:coverage",
    "e2e": "pnpm -r --if-present e2e",
    "build": "pnpm -r --if-present build",
    "check": "pnpm generate:icons && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "docs:dev": "pnpm --filter vitepress-theme-neptu-blog-docs dev",
    "docs:build": "pnpm --filter vitepress-theme-neptu-blog-docs build",
    "docs:preview": "pnpm --filter vitepress-theme-neptu-blog-docs preview",
    "landing:dev": "pnpm --filter vitepress-theme-neptu-landing-example dev",
    "landing:build": "pnpm --filter vitepress-theme-neptu-landing-example build",
    "landing:preview": "pnpm --filter vitepress-theme-neptu-landing-example preview"
  }
}
